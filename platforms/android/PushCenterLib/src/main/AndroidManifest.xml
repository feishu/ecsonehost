<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
          package="com.ucmed.pushcenterlib">

    <uses-permission android:name="com.coloros.mcs.permission.RECIEVE_MCS_MESSAGE" />
    <uses-permission android:name="android.permission.REORDER_TASKS"/>



    <application
    >

        <meta-data
            android:name="com.huawei.hms.client.appid"
            android:value="${HW_APPID}"
            tools:replace="android:value">
        </meta-data>

        <meta-data
            android:name="OPPO_appKey"
            android:value="${OPPO_appKey}">
        </meta-data>
        <meta-data
            android:name="OPPO_appSecret"
            android:value="${OPPO_appSecret}">
        </meta-data>

        <meta-data
            android:name="Mi_APP_ID"
            android:value="${Mi_APP_ID}">
        </meta-data>
        <meta-data
            android:name="Mi_APP_KEY"
            android:value="${Mi_APP_KEY}">
        </meta-data>

        <meta-data
            android:name="MZ_APP_ID"
            android:value="${MZ_APP_ID}">
        </meta-data>
        <meta-data
            android:name="MZ_APP_KEY"
            android:value="${MZ_APP_KEY}">
        </meta-data>

        <meta-data
            android:name="VIVO_APP_ID"
            android:value="${VIVO_APP_ID}">
        </meta-data>
        <meta-data
            android:name="VIVO_APP_KEY"
            android:value="${VIVO_APP_KEY}">
        </meta-data>

        <receiver
            android:name=".XgPush.TSLXGReceiver"
            android:exported="false">
            <intent-filter>
                <!-- 接收消息透传 -->
                <action android:name="com.tencent.android.tpush.action.PUSH_MESSAGE"/>
                <!-- 监听注册、反注册、设置/删除标签、通知被点击等处理结果 -->
                <action android:name="com.tencent.android.tpush.action.FEEDBACK"/>
            </intent-filter>
        </receiver>

        <!--接受广播显示通知,通知点击的回调-->
        <receiver android:name=".TSLNotificationUtil$TSLNotificationClickMsgReceiver"
        >
            <intent-filter >
                <action android:name="${applicationId}.tslpush.notification.click" /> 
            </intent-filter>
        </receiver>

        <receiver android:name=".XgPush.TSLHWReceiver">
            <intent-filter>

                <!-- 必须,用于接收TOKEN -->
                <action android:name="com.huawei.android.push.intent.REGISTRATION"/>
                <!-- 必须，用于接收消息 -->
                <action android:name="com.huawei.android.push.intent.RECEIVE"/>
                <!-- 可选，用于点击通知栏或通知栏上的按钮后触发onEvent回调 -->
                <action android:name="com.huawei.android.push.intent.CLICK"/>
                <!-- 可选，查看PUSH通道是否连接，不查看则不需要 -->
                <action android:name="com.huawei.intent.action.PUSH_STATE"/>
            </intent-filter>
        </receiver>

        <!--
        如果应用需要解析和处理Push消息（如透传消息），则继承PushService来处理，并在此申明
        如果不需要处理Push消息，则直接申明PsuhService即可
        -->
        <service
            android:name="com.ucmed.pushcenterlib.OPPOPush.PushMessageService"
            android:permission="com.coloros.mcs.permission.SEND_MCS_MESSAGE">
            <intent-filter>
                <action android:name="com.coloros.mcs.action.RECEIVE_MCS_MESSAGE" />
            </intent-filter>
        </service>

        <provider
            android:name=".XgPush.TSLXgPushProvider"
            android:authorities="${applicationId}.tslxgpush"
            android:exported="false"/>
        <provider
            android:name="com.ucmed.pushcenterlib.tslpushcenter.TSLPushProvider"
            android:authorities="${applicationId}.tslpush"
            android:enabled="true"
            android:exported="false"/>
    </application>
</manifest>
