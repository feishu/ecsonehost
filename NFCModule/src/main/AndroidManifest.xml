<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.weexextra.nfcmodule">

    <uses-permission android:name="android.permission.NFC"/> <!-- 要求当前设备必须要有NFC芯片 -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true"/>

    <application>
        <receiver
            android:name=".NFCReceiver"
            android:enabled="true"
            android:exported="false">
        </receiver>
        <provider
            android:name="com.weexextra.nfcmodule.NFCProvider"
            android:authorities="${applicationId}.NFCProvider"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>